    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "sass": "^1.86.0",
    "typescript": "6.0.3",
