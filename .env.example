APP_ENV=local
PUBLIC_ORIGIN=https://localhost:5173
DATABASE_URL=postgresql+psycopg://clinic_runtime:CHANGE_ME@localhost:5432/clinic # pragma: allowlist secret
# Only the migration CLI reads this URL; never expose it to frontend/runtime deployment.
MIGRATION_DATABASE_URL=postgresql+psycopg://clinic_migrator:CHANGE_ME@localhost:5432/clinic # pragma: allowlist secret
# Generate independently; no working defaults.
TOKEN_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
FIELD_KEY=REPLACE_WITH_FERNET_KEY
MFA_REQUIRED=true
